  ],
  "properties": [
    {
      "name": "fs.preview.buffer-size",
      "type": "java.lang.Integer",
      "description": "缓冲区大小（字节），默认8KB",
      "sourceType": "com.xddcodec.fs.framework.preview.config.FilePreviewConfig",
      "defaultValue": 8192
    },
    {
      "name": "fs.preview.max-file-size",
      "type": "java.lang.Long",
      "description": "预览文件最大大小（字节），默认500MB",
      "sourceType": "com.xddcodec.fs.framework.preview.config.FilePreviewConfig",
      "defaultValue": 524288000
    },
    {
      "name": "fs.preview.max-range-size",
      "type": "java.lang.Long",
      "description": "单次Range请求最大大小（字节），默认10MB",
      "sourceType": "com.xddcodec.fs.framework.preview.config.FilePreviewConfig",
      "defaultValue": 10485760
    },
    {
      "name": "fs.preview.office.cache-path",
      "type": "java.lang.String",
      "description": "转换缓存目录",
      "sourceType": "com.xddcodec.fs.framework.preview.office.OfficeToPdfConfig",
      "defaultValue": "\/tmp\/office-convert"
    },
    {
      "name": "fs.preview.office.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用转换",
      "sourceType": "com.xddcodec.fs.framework.preview.office.OfficeToPdfConfig",
      "defaultValue": true
    },
    {
      "name": "fs.preview.office.max-tasks-per-process",
      "type": "java.lang.Integer",
      "description": "最大任务数",
      "sourceType": "com.xddcodec.fs.framework.preview.office.OfficeToPdfConfig",
      "defaultValue": 200
    },
    {
      "name": "fs.preview.office.office-home",
      "type": "java.lang.String",
      "description": "LibreOffice 安装路径，用于将 Office 文档（Word、Excel、PPT）转换为 PDF 进行预览 <p><b>Windows 环境（开箱即用）：<\/b><\/p> <ul> <li>项目根目录已包含 LibreOfficePortable 便携版（位于 项目根目录\/LibreOfficePortable）<\/li> <li>无需安装 LibreOffice，系统会自动使用内置版本<\/li> <li>如需使用自定义路径，可通过此配置项覆盖<\/li> <\/ul> <p><b>Linux\/Mac 环境（需要安装）：<\/b><\/p> <ul> <li>需要手动安装 LibreOffice<\/li> <li>如果未配置此项，系统会尝试使用默认路径： <ul> <li>Linux: \/usr\/lib\/libreoffice<\/li> <li>Mac: \/Applications\/LibreOffice.app\/Contents<\/li> <\/ul> <\/li> <li>如果 LibreOffice 安装在其他位置，必须通过此配置项指定<\/li> <\/ul> <p><b>配置示例：<\/b><\/p> <pre> # application.yml fs: preview: office: # Windows 环境通常不需要配置（使用内置版本） # Linux\/Mac 环境如果安装在默认路径也不需要配置 # 仅在以下情况需要配置： # 1. Windows 环境想使用本地安装的 LibreOffice # 2. Linux\/Mac 环境 LibreOffice 安装在非默认路径 office-home: \/opt\/libreoffice <\/pre> <p><b>注意事项：<\/b><\/p> <ul> <li>Windows 开发者：确保项目根目录下有 LibreOfficePortable 文件夹，然后直接运行即可<\/li> <li>Linux\/Mac 开发者：首次运行前请确保已安装 LibreOffice<\/li> <li>如果路径配置错误或 LibreOffice 未安装，系统启动时会抛出异常并提供安装指引<\/li> <\/ul>",
      "sourceType": "com.xddcodec.fs.framework.preview.office.OfficeToPdfConfig"
    },
    {
      "name": "fs.preview.office.task-execution-timeout",
      "type": "java.lang.Long",
      "description": "任务执行超时（毫秒）",
      "sourceType": "com.xddcodec.fs.framework.preview.office.OfficeToPdfConfig",
      "defaultValue": 120000
    },
    {
      "name": "fs.preview.office.task-queue-timeout",
      "type": "java.lang.Long",
      "description": "任务队列超时（毫秒）",
      "sourceType": "com.xddcodec.fs.framework.preview.office.OfficeToPdfConfig",
      "defaultValue": 30000
    },
    {
      "name": "fs.preview.small-file-size",
      "type": "java.lang.Long",
      "description": "小文件直接传输阈值（字节），默认10MB",
      "sourceType": "com.xddcodec.fs.framework.preview.config.FilePreviewConfig",
      "defaultValue": 10485760
    },
    {
      "name": "fs.preview.stream-api",
      "type": "java.lang.String",
      "description": "预览文件流处理api",
      "sourceType": "com.xddcodec.fs.framework.preview.config.FilePreviewConfig",
      "defaultValue": "http:\/\/localhost:8080\/api\/file\/stream\/preview"
    }
  ],
